# Signer for own-infra deployments (scripts/deploy.ts).
EVM_PRIVATE_KEY=

# ── ACE Coordinator API (scripts/configure-ace.ts) ──────────────────────────
# API key for the ACE control plane (https://ace.api.chain.link). Required for
# plan, apply and verify. Provisioned per organization (Caliber style).
ACE_API_KEY=
# Apply confirmation — must match coordinatorApi.chainSelector in the manifest.
ACE_CONFIG_CONFIRM_CHAIN_SELECTOR=
# Optional manifest override (default: scripts/ace-configuration.json).
ACE_CONFIG_MANIFEST=
# Optional HTTP timeout override for Coordinator API calls (ms, default 30000).
ACE_HTTP_TIMEOUT_MS=

# ── Own-infra deployment (scripts/deploy.ts) ─────────────────────────────────
# Phase to run: "extractors" (extractor + policy implementation contracts) or
# "factory" (PropertyFactory + PropertyToken implementation). The pnpm
# scripts (deploy:extractors / deploy:factory) set this for you.
DEPLOY_PHASE=

# ── Cross-chain tooling (scripts/ccip-register.ts) ───────────────────────────
CCIP_TOKEN=
CCIP_POOL=
# Optional: alternative mint policy / bypass policy to wire instead of the
# product's defaults.
CCIP_MINT_POLICY=
CCIP_BYPASS_POLICY=

# ── Cross-chain tooling (scripts/setup-identity-sync.ts) ─────────────────────
# Home-chain sender + writer policy, destination receiver + selector spaces.
# Comma-separated for multi-destination fields.
SYNC_SENDER=
SYNC_WRITER_POLICY=
SYNC_RECEIVER=
SYNC_SOURCE_SELECTOR=
SYNC_HOME_SENDER=
SYNC_DEST_RECEIVERS=
SYNC_DEST_SELECTORS=
