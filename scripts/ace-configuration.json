		"engine": { "uuid": null, "address": "0x0000000000000000000000000000000000000000" },
		"registries": {
			"identityRegistry": { "uuid": null, "address": "0x0000000000000000000000000000000000000000" },
			"credentialRegistry": { "uuid": null, "address": "0x0000000000000000000000000000000000000000" }
		},
		"policies": {
			"writer": { "uuid": null, "address": "0x0000000000000000000000000000000000000000" },
			"reject-list": { "uuid": null, "address": "0x0000000000000000000000000000000000000000" }
		},
		"factory": "0x0000000000000000000000000000000000000000",
		"tokenImplementation": "0x0000000000000000000000000000000000000000"
	},
	"notes": [
		"Own infra (extractors, policy implementations, factory, tokens) is deployed by scripts/deploy.ts and recorded here.",
		"ACE-owned resources (PolicyEngine, registries, policy instances, targets, protections) are created by scripts/configure-ace.ts against the Coordinator API.",
		"Policy parameter schemas (policyImplementations[*].configSchema) and initial configs come from the platform (GET /policy-implementations); fill them from the live API before apply.",
		"Product tokens and escrows are factory-created per product; their per-product wiring is factory-owned onchain and is outside this manifest's scope."
	]
}
